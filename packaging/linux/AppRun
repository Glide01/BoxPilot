#!/bin/sh
# AppImage entry point. The runtime sets $APPDIR to the mounted (or
# extracted) AppDir; fall back to this script's own directory when run by
# hand from an unpacked AppDir. sing-box sits next to box-pilot in usr/bin,
# which is where BoxPilot looks for it (the directory of its own executable).
HERE="$(dirname "$(readlink -f "$0")")"
APPDIR="${APPDIR:-$HERE}"
exec "$APPDIR/usr/bin/box-pilot" "$@"
